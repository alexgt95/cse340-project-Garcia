<%- include('partials/header') %>
        <div id="hero">
            <div id="hero-box">
                <picture>
                    <source srcset="images/hair-salon-ashburn-hero-welcome.webp" type="image/webp">
                    <img id="hero-img" src="images/hair-salon-ashburn-hero-welcome.jpg"
                        alt="Hair salon services display">
                </picture>
            </div>
            <!--
            <div id="hero-msg">
                <div class="button-box">
                    <a class="btn" href="/services">View Services</a>
                </div>
            </div>
            -->
        </div>
        <h1 class="primary-heading">Full Service Hair Salon</h1>
        <main class="home-page-grid">


            <picture style="display: contents;">
                <source srcset="images/balayage-highlights-long-hair.webp" type="image/webp">
                <img id="balayageImg" class="modal-trigger" src="images/balayage-highlights-long-hair.jpg"
                    alt="Balayage hair highlights on long hair">
            </picture>


            <section class="home-page-text-1">
                <h2>What We Offer</h2>
                <p>We are passionate about hair, and that passion is reflected in every client we serve. Through ongoing
                    education, our stylists stay updated on the latest trends,
                    styles, and coloring techniques to deliver the results you’re looking for</p>
            </section>

            <picture style="display: contents;">
                <source srcset="images/mens-fade-haircut-style.webp" type="image/webp">
                <img id="haircutImg" class="modal-trigger" src="images/mens-fade-haircut-style.jpg"
                    alt="Men's haircut style at the salon">
            </picture>

            <section class="home-page-text-2">
                <h2>Welcome</h2>
                <p>Welcome to OUR HAIR SALON, where your hair is cared for and styled by experienced professionals who
                    are dedicated to helping you look and feel your best. From the moment you walk
                    through our doors, our goal is to provide a relaxing and welcoming environment where you can enjoy
                    personalized service and attention. We specialize in a variety of services, including precision
                    haircuts,
                    custom color, balayage, and treatments designed to keep your hair healthy, vibrant, and full of
                    life. Our stylists stay up to date with the latest trends and techniques through continuous
                    education,
                    ensuring you receive modern, high-quality results every time. Whether you’re looking for a simple
                    refresh or a complete transformation, we take the time to understand your style and bring your
                    vision to
                    life with care and creativity.</p>

            </section>

            <section class="contact-form-1">
                <h2 class="primary-heading">CONTACT US</h2>
                <%- include('partials/contact-form', { errors: {}, values: {} }) %>
            </section>
        </main>
        <%- include('partials/footer') %>