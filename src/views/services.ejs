<%- include('partials/header') %>
        <div id="hero">
            <div id="hero-box">
                <picture>
                    <source srcset="/images/hair-salon-services-menu-hero.webp" type="image/webp">
                    <img id="hero-img" src="/images/hair-salon-services-menu-hero.jpg" alt="Hair salon services display">
                </picture>
            </div>
        </div>
        <h1>Our Services</h1>

        <form id="filter-container" action="/services" method="get">
            <label for="category">Select Category:</label>
            <select id="category" name="category">
                <option value="">All</option>
                <% categories.forEach((category) => { %>
                    <option value="<%= category.slug %>" <%= category.slug === selectedCategory ? 'selected' : '' %>><%= category.name %></option>
                <% }) %>
            </select>
            <button class="btn" type="submit">Filter</button>
        </form>

        <main>
            <div id="service-container">
                <% if (services.length === 0) { %>
                    <p>No services found.</p>
                <% } %>
                <% services.forEach((service) => { %>
                    <section class="service-card">
                        <div class="service-image">
                            <picture style="display: contents;">
                                <source srcset="<%= service.image_url.replace(/\.jpg$/, '.webp') %>" type="image/webp">
                                <img src="<%= service.image_url %>" alt="<%= service.name %>" loading="lazy">
                            </picture>
                        </div>
                        <div class="service-info">
                            <div class="service-category">
                                <span><%= service.category_name %></span>
                            </div>
                            <h2><a href="/services/<%= service.slug %>"><%= service.name %></a></h2>
                            <p class="service-description"><%= service.description %></p>
                            <p class="service-duration"><strong>Duration:</strong> <%= service.duration_minutes %> min</p>
                            <p class="service-price">
                                <strong>Price:</strong>
                                Short $<%= service.prices.short %> · Mid $<%= service.prices.mid %> · Long $<%= service.prices.long %>
                            </p>

                            <%- include('partials/book-form', { service }) %>
                        </div>
                    </section>
                <% }) %>
            </div>
        </main>
<%- include('partials/footer') %>