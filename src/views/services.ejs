<%- include('partials/header') %>
        <div id="hero">
            <div id="hero-box">
                <picture>
                    <source srcset="/images/hair-salon-services-menu-hero.webp" type="image/webp">
                    <img id="hero-img" src="/images/hair-salon-services-menu-hero.jpg" alt="Hair salon services display">
                </picture>
            </div>
        </div>
        <h1>Our Services</h1>

        <form id="filter-container" action="/services" method="get">
            <label for="category">Select Category:</label>
            <select id="category" name="category">
                <option value="">All</option>
                <% categories.forEach((category) => { %>
                    <option value="<%= category %>" <%= category === selectedCategory ? 'selected' : '' %>><%= category %></option>
                <% }) %>
            </select>
            <button class="btn" type="submit">Filter</button>
        </form>

        <main>
            <div id="service-container">
                <% if (services.length === 0) { %>
                    <p>No services found.</p>
                <% } %>
                <% services.forEach((service, index) => { %>
                    <section class="service-card">
                        <div class="service-image">
                            <picture style="display: contents;">
                                <source srcset="<%= service.image.replace(/\.jpg$/, '.webp') %>" type="image/webp">
                                <img src="<%= service.image %>" alt="<%= service.name %>" loading="lazy">
                            </picture>
                        </div>
                        <div class="service-info">
                            <div class="service-category">
                                <% service.category.forEach((category) => { %>
                                    <span><%= category %></span>
                                <% }) %>
                            </div>
                            <h2><%= service.name %></h2>
                            <p class="service-description"><%= service.description %></p>
                            <p class="service-duration"><strong>Duration:</strong> <%= service.duration %></p>
                            <p class="service-price">
                                <strong>Price:</strong>
                                Short $<%= service.price.short %> · Mid $<%= service.price.mid %> · Long $<%= service.price.long %>
                            </p>

                            <!-- Native GET form: sends ?service=...&length=... to the booking page, no JS needed -->
                            <form action="/book" method="get">
                                <input type="hidden" name="service" value="<%= service.name %>">
                                <label for="length-<%= index %>">Select hair length:</label>
                                <select class="hair-length" id="length-<%= index %>" name="length" required>
                                    <option value="">--Choose--</option>
                                    <option value="short">Short Hair</option>
                                    <option value="mid">Mid Length</option>
                                    <option value="long">Long Hair</option>
                                </select>
                                <button class="select-service-btn btn" type="submit">Book this service</button>
                            </form>
                        </div>
                    </section>
                <% }) %>
            </div>
        </main>
<%- include('partials/footer') %>
