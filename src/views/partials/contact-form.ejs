<!-- Contact form: posts to the server. errors/values are empty on a fresh form -->
<form action="/contact" method="post">
    <p>
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" placeholder="Your name" required maxlength="100"
               value="<%= values.name ?? '' %>" <%= errors.name ? 'aria-invalid=true aria-describedby=name-error' : '' %>>
        <% if (errors.name) { %><span class="field-error" id="name-error"><%= errors.name.msg %></span><% } %>
    </p>
    <p>
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" placeholder="name@example.com" required maxlength="255"
               value="<%= values.email ?? '' %>" <%= errors.email ? 'aria-invalid=true aria-describedby=email-error' : '' %>>
        <% if (errors.email) { %><span class="field-error" id="email-error"><%= errors.email.msg %></span><% } %>
    </p>
    <p>
        <label for="msg">Message:</label>
        <textarea id="msg" name="message" placeholder="Write your message..." required minlength="10" maxlength="2000"
                  <%= errors.message ? 'aria-invalid=true aria-describedby=msg-error' : '' %>><%= values.message ?? '' %></textarea>
        <% if (errors.message) { %><span class="field-error" id="msg-error"><%= errors.message.msg %></span><% } %>
    </p>
    <p class="button-1">
        <button class="btn" type="submit">Send your message</button>
    </p>
</form>